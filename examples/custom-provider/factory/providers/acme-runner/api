#!/usr/bin/env python3
"""The api program of the Acme Runner provider.

Fabrica runs `api <op>`, writes one JSON request to stdin, and reads one JSON
response from stdout. A non-zero exit (with a message on stderr) means the
operation failed.

A real provider would call the runtime's HTTP API here, with credentials
from environment variables. This example keeps its "runtime" in a JSON file
instead, so you can watch what Fabrica does: set ACME_RUNNER_DB to choose
the file (default ~/.acme-runner.json).

Only the Python standard library is used, so there's nothing to install.
"""

import json
import os
import sys
import uuid

DB = os.environ.get("ACME_RUNNER_DB", os.path.expanduser("~/.acme-runner.json"))


def load():
    try:
        with open(DB) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def save(resources):
    tmp = DB + ".tmp"
    with open(tmp, "w") as f:
        json.dump(resources, f, indent=2, sort_keys=True)
    os.replace(tmp, DB)


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


def main():
    if len(sys.argv) != 2:
        fail("usage: api <list|create|update|delete>")
    op = sys.argv[1]
    request = json.load(sys.stdin)
    if request.get("version") != 1:
        fail(f"this provider speaks protocol version 1, not {request.get('version')}")

    resources = load()

    if op == "list":
        # Everything whose identity belongs to this deployment's endpoint.
        endpoint = request["endpoint"].split("://", 1)[-1]
        found = [
            {"identity": r["identity"], "remote_id": rid, "fingerprint": r["fingerprint"]}
            for rid, r in sorted(resources.items())
            if r["identity"].startswith(endpoint + "#")
        ]
        print(json.dumps({"resources": found}))

    elif op in ("create", "update"):
        resource = request["resource"]
        remote_id = request.get("remote_id") or "acme_" + uuid.uuid4().hex[:8]
        if op == "update" and remote_id not in resources:
            fail(f"there's no resource {remote_id} to update")
        resources[remote_id] = {
            # The identity must be stored somewhere we can read it back,
            # so `list` can return it.
            "identity": resource["identity"],
            "fingerprint": resource["fingerprint"],
            "trigger": resource["trigger"],
            "connectors": resource["connectors"],
            "prompt": resource["prompt"],
            # The token is a secret: a real provider would store it in the
            # runtime's secret store and never print or log it.
            "fabrica_url": resource["fabrica"]["url"],
            "fabrica_token_set": bool(resource["fabrica"]["token"]),
        }
        save(resources)
        print(json.dumps({"remote_id": remote_id}))

    elif op == "delete":
        remote_id = request["remote_id"]
        if resources.pop(remote_id, None) is None:
            fail(f"there's no resource {remote_id} to delete")
        save(resources)
        print("{}")

    else:
        fail(f"unknown operation {op!r}")


if __name__ == "__main__":
    main()
